---
import Socials from "./Socials.astro";
import { SITE } from "@config";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="frame frame-grid">
    <!-- The site's h-card: who it belongs to, for Bridgy Fed and other IndieWeb readers. -->
    <p class="colophon">
      &#169; {currentYear}
      <a class="h-card" href={SITE.website}>{SITE.author}</a>
    </p>
    <Socials rss />
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid rgb(var(--color-border));
    padding-block: 1.5rem 2.5rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.9375rem;
  }
  .colophon {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .colophon a {
    text-decoration: none;
    color: rgb(var(--color-text-base));
    margin-left: 0.3em;
  }
</style>
