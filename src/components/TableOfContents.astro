---
import type { MarkdownHeading } from "astro";

export interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Only surface section headings. Depth 1 is the post title; the auto-generated
// "Table of contents" heading (remark-toc) would duplicate this navigator.
const toc = headings.filter(
  h => h.depth >= 2 && h.depth <= 4 && h.slug !== "table-of-contents"
);
---

{
  toc.length > 0 && (
    <>
      {/* Desktop: a contents list in the margin column, sticky beside the text. */}
      <nav class="toc-margin" aria-labelledby="toc-heading">
        <h2 id="toc-heading" class="toc-heading">
          Contents
        </h2>
        <ul class="toc-list">
          {toc.map(h => (
            <li>
              <a
                href={`#${h.slug}`}
                class="toc-link"
                data-toc-link
                data-target={h.slug}
                data-depth={h.depth}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Mobile / narrow: a sticky running head naming the current section;
          it opens the contents as a bottom sheet. */}
      <div class="toc-mobile">
        <button
          type="button"
          class="toc-fab"
          data-toc-toggle
          aria-expanded="false"
          aria-controls="toc-sheet"
        >
          <span class="toc-fab-label">Contents</span>
          <span class="toc-fab-current" data-toc-current />
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 10l5 5 5-5z" />
          </svg>
        </button>

        <div id="toc-sheet" class="toc-sheet" data-toc-sheet hidden>
          <div class="toc-sheet-backdrop" data-toc-close />
          <div
            class="toc-sheet-panel"
            role="dialog"
            aria-modal="true"
            aria-label="On this page"
          >
            <div class="toc-sheet-header">
              <span>On this page</span>
              <button
                type="button"
                class="toc-sheet-close"
                data-toc-close
                aria-label="Close"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6.4 5 12.6 12.6-1.4 1.4L5 6.4 6.4 5Z" />
                  <path d="M19 6.4 6.4 19 5 17.6 17.6 5 19 6.4Z" />
                </svg>
              </button>
            </div>
            <ul class="toc-sheet-list">
              {toc.map(h => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="toc-sheet-link"
                    data-toc-link
                    data-target={h.slug}
                    data-depth={h.depth}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </>
  )
}

<style>
  /* ===== Desktop margin contents ===== */
  .toc-margin {
    display: none;
  }
  @media (min-width: 1024px) {
    .toc-margin {
      display: block;
      position: sticky;
      top: 2rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      padding-bottom: 1rem;
    }
  }
  .toc-heading {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-text-muted));
    margin-bottom: 0.5rem;
  }
  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .toc-link {
    position: relative;
    display: block;
    padding: 0.4rem 0 0.4rem 1.5rem;
    color: rgb(var(--color-text-muted));
    text-decoration: none;
  }
  .toc-link[data-depth="3"] {
    padding-left: 2.25rem;
    font-size: 0.875rem;
  }
  .toc-link[data-depth="4"] {
    padding-left: 3rem;
    font-size: 0.875rem;
  }
  /* The position mark: a short printed rule that lengthens and takes the
     series ink on the section you're reading. */
  .toc-link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.95em;
    width: 0.625rem;
    height: 1px;
    background-color: rgb(var(--color-card-muted));
  }
  .toc-link:hover {
    color: rgb(var(--color-text-base));
  }
  .toc-link.is-active {
    color: rgb(var(--color-text-base));
    font-weight: 600;
  }
  .toc-link.is-active::before {
    width: 1.125rem;
    height: 3px;
    top: calc(0.95em - 1px);
    background-color: rgb(var(--color-accent));
  }

  /* ===== Mobile FAB + bottom sheet ===== */
  .toc-mobile {
    display: block;
  }
  @media (min-width: 1024px) {
    .toc-mobile {
      display: none;
    }
  }

  .toc-mobile {
    position: sticky;
    top: 0;
    z-index: 30;
    margin-inline: calc(-1 * clamp(1.25rem, 5vw, 4.5rem));
    margin-top: -2.5rem;
    margin-bottom: 2rem;
  }
  .toc-fab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 2.75rem;
    padding-inline: clamp(1.25rem, 5vw, 4.5rem);
    background-color: rgb(var(--color-raised));
    border-bottom: 1px solid rgb(var(--color-border));
    font-size: 0.875rem;
    text-align: left;
  }
  .toc-fab-label {
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-accent));
    font-size: 0.8125rem;
  }
  .toc-fab-current {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(var(--color-text-muted));
  }
  .toc-fab svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: rgb(var(--color-text-base));
    flex-shrink: 0;
  }

  .toc-sheet {
    position: fixed;
    inset: 0;
    z-index: 50;
  }
  .toc-sheet[hidden] {
    display: none;
  }

  .toc-sheet-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .toc-sheet.is-open .toc-sheet-backdrop {
    opacity: 1;
  }

  .toc-sheet-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    background-color: rgb(var(--color-fill));
    border-top: 0.5rem solid rgb(var(--color-band));
    transform: translateY(100%);
    transition: transform 0.25s ease;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .toc-sheet.is-open .toc-sheet-panel {
    transform: translateY(0);
  }

  .toc-sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    font-weight: 700;
    border-bottom: 1px solid rgb(var(--color-border));
  }
  .toc-sheet-close {
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .toc-sheet-close svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: rgb(var(--color-text-base));
  }

  .toc-sheet-list {
    margin: 0;
    padding: 0.5rem 0.5rem 1rem;
    list-style: none;
    overflow-y: auto;
  }
  .toc-sheet-list li {
    margin: 0;
  }
  .toc-sheet-link {
    display: block;
    padding: 0.6rem 0.75rem;
    font-size: 0.95rem;
    text-decoration: none;
    color: rgb(var(--color-text-base));
  }
  .toc-sheet-link[data-depth="3"] {
    padding-left: 1.6rem;
    font-size: 0.9rem;
    color: rgb(var(--color-text-muted));
  }
  .toc-sheet-link[data-depth="4"] {
    padding-left: 2.4rem;
    font-size: 0.9rem;
    color: rgb(var(--color-text-muted));
  }
  .toc-sheet-link.is-active {
    color: rgb(var(--color-accent));
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-sheet-backdrop,
    .toc-sheet-panel {
      transition: none;
    }
  }
</style>

<script>
  function initToc() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    );
    if (links.length === 0) return;

    // A slug can map to multiple links (desktop rail + mobile sheet).
    const linksBySlug = new Map<string, HTMLAnchorElement[]>();
    const targets: HTMLElement[] = [];
    const seen = new Set<string>();

    for (const link of links) {
      const slug = link.dataset.target;
      if (!slug) continue;
      const heading = document.getElementById(slug);
      if (!heading) continue;
      if (!linksBySlug.has(slug)) linksBySlug.set(slug, []);
      linksBySlug.get(slug)!.push(link);
      if (!seen.has(slug)) {
        seen.add(slug);
        targets.push(heading);
      }
    }

    if (targets.length > 0) {
      let activeSlug: string | null = null;
      const setActive = (slug: string) => {
        if (slug === activeSlug) return;
        activeSlug = slug;
        for (const link of links) link.classList.remove("is-active");
        for (const link of linksBySlug.get(slug) ?? [])
          link.classList.add("is-active");
        const current = document.querySelector("[data-toc-current]");
        const label = linksBySlug.get(slug)?.[0]?.textContent?.trim();
        if (current && label) current.textContent = label;
      };

      const observer = new IntersectionObserver(
        entries => {
          const visible = entries
            .filter(e => e.isIntersecting)
            .sort(
              (a, b) => a.boundingClientRect.top - b.boundingClientRect.top
            );
          if (visible.length > 0) setActive(visible[0].target.id);
        },
        { rootMargin: "0px 0px -70% 0px", threshold: 0 }
      );

      for (const target of targets) observer.observe(target);
    }

    // ===== Bottom-sheet open/close wiring =====
    const sheet = document.querySelector<HTMLElement>("[data-toc-sheet]");
    const toggle =
      document.querySelector<HTMLButtonElement>("[data-toc-toggle]");
    if (!sheet || !toggle) return;

    const open = () => {
      sheet.hidden = false;
      // Next frame so the transition runs from the hidden state.
      requestAnimationFrame(() => sheet.classList.add("is-open"));
      toggle.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add("toc-sheet-open");
    };
    const close = () => {
      sheet.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      document.documentElement.classList.remove("toc-sheet-open");
      const onEnd = () => {
        sheet.hidden = true;
        sheet.removeEventListener("transitionend", onEnd);
      };
      sheet.addEventListener("transitionend", onEnd);
    };

    toggle.addEventListener("click", () =>
      sheet.classList.contains("is-open") ? close() : open()
    );
    for (const el of sheet.querySelectorAll("[data-toc-close]"))
      el.addEventListener("click", close);
    // Tapping a heading closes the sheet; the anchor handles the jump.
    for (const link of sheet.querySelectorAll("[data-toc-link]"))
      link.addEventListener("click", close);
    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && sheet.classList.contains("is-open")) close();
    });
  }

  initToc();
</script>
