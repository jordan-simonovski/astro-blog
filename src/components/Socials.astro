---
import { SOCIALS } from "@config";

export interface Props {
  rss?: boolean;
}

const { rss = false } = Astro.props;
// CV already sits in the masthead.
const links = SOCIALS.filter(s => s.active && s.name !== "CV");
---

<ul class="socials">
  {
    rss && (
      <li>
        <a href="/rss.xml">RSS</a>
      </li>
    )
  }
  {
    links.map(s => (
      <li>
        <a href={s.href} rel="me noopener" title={s.linkTitle}>
          {s.name === "Github" ? "GitHub" : s.name}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    font-weight: 500;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-card-muted));
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
  }
  .socials a:hover {
    text-decoration-color: currentColor;
  }
</style>
