---
import { LOCALE } from "@config";

export interface Props {
  datetime: string | Date;
  readingTime?: string;
  class?: string;
}

const { datetime, readingTime, class: className } = Astro.props;

const date = new Date(datetime);
const label = date.toLocaleDateString(LOCALE, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<span class:list={["dateline", className]}>
  <time class="dt-published" datetime={date.toISOString()}>{label}</time>
  {readingTime && <span>{readingTime}</span>}
</span>

<style>
  .dateline {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
  }
  .dateline > * + *::before {
    content: "·";
    margin-right: 0.5em;
  }
</style>
