---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card.astro";
import Datetime from "@components/Datetime.astro";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import {
  SERIES,
  SERIES_KEYS,
  postsInSeries,
  seriesNumber,
} from "@utils/series";
import smartQuotes from "@utils/smartQuotes";

const posts = await getSortedPosts(await getCollection("blog"));
const latest = posts[0];

// The shelf: every series, newest title first, the series of the latest post
// leading.
const order = [
  latest.data.series,
  ...SERIES_KEYS.filter(k => k !== latest.data.series),
];
const shelves = order.map(key => ({
  key,
  info: SERIES[key],
  titles: postsInSeries(posts, key)
    .map((post, i) => ({ post, number: String(i + 1).padStart(2, "0") }))
    .reverse(),
}));
---

<Layout>
  <Header />
  <main id="main-content">
    <section class="title-band">
      <div class="frame frame-grid">
        <div class="intro">
          <h1>Jordan’s Blog</h1>
          <p class="lede">
            Hi 👋 I'm Jordan! I sit somewhere between software development and
            SRE. I've been writing about various topics, but my current
            interests are SRE, Observability, and systems. May or may not use
            this as a place to dump my recipes alongside my thoughts.
          </p>
          <Socials rss />
        </div>
      </div>
    </section>
    <div class="band-rule" aria-hidden="true"></div>

    <section
      class="latest"
      data-series={latest.data.series}
      aria-labelledby="latest-heading"
    >
      <div class="frame frame-grid">
        <h2 id="latest-heading" class="shelf-label latest-label">
          <span>Latest</span>
          <span class="series-code"
            >{SERIES[latest.data.series].name}
            {seriesNumber(posts, latest)}</span
          >
        </h2>
        <div>
          <h3 class="latest-title">
            <a href={`/posts/${slugify(latest.data)}`}
              >{smartQuotes(latest.data.title)}</a
            >
          </h3>
          <p class="latest-deck">{latest.data.description}</p>
          <p class="meta latest-meta">
            <span class="series-code latest-code"
              >{SERIES[latest.data.series].name}
              {seriesNumber(posts, latest)}</span
            >
            <Datetime
              datetime={latest.data.pubDatetime}
              readingTime={latest.data.readingTime}
            />
          </p>
        </div>
      </div>
    </section>

    {
      shelves.map(({ key, info, titles }) => (
        <section
          class="shelf"
          data-series={key}
          aria-labelledby={`shelf-${key}`}
        >
          <div class="shelf-rule" aria-hidden="true" />
          <div class="frame frame-grid">
            <h2 id={`shelf-${key}`} class="shelf-label">
              <a href={`/series/${key}`}>{info.name}</a>
              <span class="shelf-count">
                {titles.length} {titles.length === 1 ? "title" : "titles"}
              </span>
            </h2>
            <ul>
              {titles.map(({ post, number }) => (
                <Card
                  href={`/posts/${slugify(post.data)}`}
                  frontmatter={post.data}
                  number={number}
                  secHeading={false}
                />
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </main>

  <Footer />
</Layout>

<style>
  .title-band {
    background-color: rgb(var(--color-raised));
    padding-block: 2.5rem 2rem;
  }
  @media (min-width: 1024px) {
    .title-band {
      padding-block: 3.5rem 2.75rem;
    }
    .intro {
      grid-column: 2;
    }
  }
  h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .lede {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    max-width: 38rem;
    font-family: var(--font-content);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  /* ===== Latest: the newest title, set large in its series ink ===== */
  .latest {
    padding-block: 2.5rem 3rem;
  }
  .latest-title {
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.25rem);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.012em;
    max-width: 26ch;
  }
  .latest-title a {
    text-decoration: none;
  }
  .latest-title a:hover {
    text-decoration: underline;
    text-decoration-color: rgb(var(--color-accent));
    text-decoration-thickness: 3px;
    text-underline-offset: 0.15em;
  }
  .latest-deck {
    margin-top: 0.75rem;
    max-width: 38rem;
    font-family: var(--font-content);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgb(var(--color-text-muted));
  }
  .latest-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    margin-top: 0.75rem;
  }
  .latest-code::after {
    content: "·";
    margin-left: 0.5em;
    color: rgb(var(--color-text-muted));
  }
  /* The "Latest" label lives in the margin; without a margin it would be an
     eyebrow over the title, so narrow screens drop it (the heading stays for
     screen readers) and carry the series code in the meta line. */
  @media (max-width: 1023px) {
    .latest-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (min-width: 1024px) {
    .latest-code {
      display: none;
    }
  }

  /* ===== The shelf: one band of series ink per series ===== */
  .shelf {
    padding-bottom: 2.5rem;
  }
  .shelf-rule {
    height: 0.5rem;
    background-color: rgb(var(--color-band));
    margin-bottom: 1.5rem;
  }
  .shelf-label {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-accent));
    padding-block: 1.25rem 0.75rem;
  }
  .shelf-label a {
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;
  }
  .shelf-label a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .shelf-label .series-code,
  .shelf-count {
    letter-spacing: 0;
    text-transform: none;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .shelf-count {
    color: rgb(var(--color-text-muted));
  }
  .latest .shelf-label > span:first-child {
    color: rgb(var(--color-text-muted));
  }
</style>
