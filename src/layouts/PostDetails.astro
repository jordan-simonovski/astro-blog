---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime.astro";
import QuoteShare from "@components/QuoteShare.astro";
import Lightbox from "@components/Lightbox.astro";
import Comments from "@components/Comments.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { GISCUS, SITE } from "@config";
import { render, type CollectionEntry } from "astro:content";
import slugify, { slugifyStr } from "@utils/slugify";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  canonicalURL,
  pubDatetime,
  tags,
  readingTime,
} = post.data;

const { Content, headings } = await render(post);

const ogUrl = new URL(
  ogImage ? ogImage : `${slugify(post.data)}.png`,
  Astro.url.origin
).href;
const pageUrl = canonicalURL
  ? new URL(canonicalURL, Astro.url.origin).href
  : Astro.url.href;

// schema.org BlogPosting, so search engines get the article metadata as data
// instead of scraping it out of the markup.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDatetime.toISOString(),
  inLanguage: "en",
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  image: ogUrl,
  keywords: tags,
  author: {
    "@type": "Person",
    name: author ?? SITE.author,
    url: SITE.website,
  },
};
---

<Layout
  title={title}
  author={author}
  description={description}
  ogImage={ogUrl}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  canonicalURL={canonicalURL}
  readingTime={readingTime}
  ogType="article"
  publishedTime={pubDatetime}
  tags={tags}
  structuredData={structuredData}
>
  <Header />
  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mt-8 mb-2 flex hover:opacity-75"
      onclick="history.back()"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>Go back</span>
    </button>
  </div>
  <TableOfContents headings={headings} />
  <main id="main-content">
    <article>
      <header>
        <h1 class="post-title">{title}</h1>
        <Datetime
          datetime={pubDatetime}
          size="lg"
          class="my-2"
          readingTime={readingTime}
        />
      </header>
      <div id="article" class="prose mx-auto mt-8 max-w-3xl">
        <Content />
      </div>
      <footer class="tags-container">
        <ul>
          {tags.map(tag => <Tag name={slugifyStr(tag)} />)}
        </ul>
      </footer>
    </article>
    <QuoteShare pageTitle={title} pageUrl={pageUrl} />
    <Lightbox />

    {
      GISCUS.enabled && (
        <section class="mt-8">
          {/* Below the fold: Comments.astro only injects giscus once the reader
              scrolls near here. */}
          <Comments />
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  .post-title {
    @apply text-skin-accent text-2xl font-semibold;
  }
  .tags-container {
    @apply my-8 px-0;
  }
</style>
