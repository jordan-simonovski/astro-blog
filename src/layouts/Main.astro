---
export interface Props {
  pageTitle: string;
  pageDesc?: string;
}

const { pageTitle, pageDesc } = Astro.props;
---

<main id="main-content">
  <header class="title-band">
    <div class="frame frame-grid">
      <slot name="margin" />
      <div class="title-col">
        <h1>{pageTitle}</h1>
        {pageDesc && <p class="desc">{pageDesc}</p>}
      </div>
    </div>
  </header>
  <div class="band-rule" aria-hidden="true"></div>
  <div class="frame frame-grid page-body">
    <div class="body-col">
      <slot />
    </div>
  </div>
</main>

<style>
  .title-band {
    background-color: rgb(var(--color-raised));
    padding-block: 2.25rem 2rem;
  }
  @media (min-width: 1024px) {
    .title-band {
      padding-block: 3rem 2.5rem;
    }
    .title-col,
    .body-col {
      grid-column: 2;
    }
  }
  h1 {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .desc {
    margin-top: 0.75rem;
    max-width: 38rem;
    font-family: var(--font-content);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgb(var(--color-text-muted));
  }
  .page-body {
    padding-block: 1.5rem 4rem;
  }
</style>
